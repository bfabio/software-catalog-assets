<!DOCTYPE html>
<head>
<meta name="csrf-param" content="authenticity_token" />
<meta name="csrf-token" content="-1vpB6R4G01OYvh3jsUwmrbH1RCnNtB0um_1zNLuvXZwkwGAw5or1nIfLLJo0-C0i9pVz2JsKij8Xhzsd0fuDw" />
</head>
<body>
<form action="/users/auth/openid_connect" method="post" style="display:none">
<input name="authenticity_token">
</form>
<script>
//<![CDATA[
const csrfToken = document.querySelector('meta[name=csrf-token]').getAttribute('content');
document.querySelector('input[name=authenticity_token]').value = csrfToken;
document.querySelector('form').submit();

//]]>
</script></body>
